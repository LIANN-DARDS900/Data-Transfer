<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RoboTransfer.App.Views.PcTransferIllustration"
             IsHitTestVisible="False" Focusable="False">
  <Viewbox Stretch="Uniform">
    <Canvas Width="460" Height="176">
      <Ellipse Canvas.Left="8" Canvas.Top="5" Width="152" Height="152" Fill="#EDF4FF"/>
      <Ellipse Canvas.Left="300" Canvas.Top="5" Width="152" Height="152" Fill="#EDF4FF"/>
      <Border Canvas.Left="22" Canvas.Top="26" Width="126" Height="87" CornerRadius="8" BorderThickness="3" BorderBrush="#758AA5" Background="White">
        <StackPanel Margin="16,16" Spacing="7">
          <Border Height="7" Width="45" Background="#9BBEFF" CornerRadius="3" HorizontalAlignment="Left"/>
          <Border Height="5" Width="74" Background="#E2EBF8" CornerRadius="2" HorizontalAlignment="Left"/>
          <Border Height="5" Width="60" Background="#E2EBF8" CornerRadius="2" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <Path Data="M 12,118 L 158,118 L 148,128 L 22,128 Z" Fill="#758AA5"/>
      <Border Canvas.Left="312" Canvas.Top="26" Width="126" Height="87" CornerRadius="8" BorderThickness="3" BorderBrush="#1468F5" Background="White">
        <Border Width="38" Height="38" CornerRadius="19" Background="#EDF4FF" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="M 0,8 L 6,14 L 18,0" Stroke="#1468F5" StrokeThickness="3" Width="18" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Border>
      <Path Data="M 302,118 L 448,118 L 438,128 L 312,128 Z" Fill="#1468F5"/>
      <Line StartPoint="172,75" EndPoint="286,75" Stroke="#B6CFFF" StrokeThickness="2" StrokeDashArray="3,4"/>
      <Border Canvas.Left="209" Canvas.Top="54" Width="42" Height="42" CornerRadius="21" Background="#1468F5">
        <Path Data="M 0,8 L 18,8 M 10,0 L 18,8 L 10,16" Stroke="White" StrokeThickness="2.5" Width="18" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Canvas.Left="48" Canvas.Top="144" Text="OLD PC" FontSize="11" FontWeight="SemiBold" Foreground="#60758A"/>
      <TextBlock Canvas.Left="340" Canvas.Top="144" Text="NEW PC" FontSize="11" FontWeight="SemiBold" Foreground="#1468F5"/>
    </Canvas>
  </Viewbox>
</UserControl>
