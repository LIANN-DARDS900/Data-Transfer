<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoboTransfer.App.ViewModels"
        xmlns:core="using:RoboTransfer.Core"
        x:Class="RoboTransfer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RoboTransfer"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="650">

  <Grid RowDefinitions="72,*">
    <Border Background="{StaticResource NavyBrush}">
      <Grid Margin="26,0" ColumnDefinitions="190,*,220" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Classes="secondary"
                  Content="← Back"
                  Command="{Binding BackCommand}"
                  IsVisible="{Binding ShowBack}"
                  Padding="14,8"
                  MinHeight="36"/>
          <StackPanel IsVisible="{Binding !ShowBack}">
            <TextBlock Text="RoboTransfer" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="PC Migration" Foreground="#BFD0DC" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding StepLabel}" Foreground="#AFC6D8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding RoleTitle}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" IsVisible="{Binding ShowBack}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
          <TextBlock Text="QUALIFICATION BUILD" Foreground="#D9E8F0" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding ApplicationVersion}" Foreground="#8FAABD" FontSize="9" MaxWidth="210" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Grid Margin="34,30,34,36" MaxWidth="980" HorizontalAlignment="Center">

        <!-- START -->
        <StackPanel IsVisible="{Binding IsWelcomePage}" Spacing="22">
          <StackPanel HorizontalAlignment="Center" MaxWidth="720">
            <TextBlock Classes="h1" Text="Move your work. Keep it simple." HorizontalAlignment="Center"/>
            <TextBlock Text="Choose what this PC is doing. RoboTransfer will guide you one step at a time."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,18,*" Margin="0,16,0,0">
            <Button Classes="choice" Command="{Binding SelectSenderCommand}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource AccentSoftBrush}">
                  <TextBlock Text="↑" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                  <TextBlock Text="Send from this PC" FontSize="23" FontWeight="SemiBold"/>
                  <TextBlock Text="Move the employee’s selected files to an approved destination."
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Margin="0,7,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Available now  →" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,18,0,0"/>
              </Grid>
            </Button>

            <Button Grid.Column="2" Classes="choice" Command="{Binding SelectReceiverCommand}" IsEnabled="{Binding ReceiverAvailable}">
              <Grid RowDefinitions="Auto,*,Auto">
                <Border Width="58" Height="58" CornerRadius="29" Background="#EEF1F4">
                  <TextBlock Text="↓" FontSize="30" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                  <TextBlock Text="Receive on this PC" FontSize="23" FontWeight="SemiBold"/>
                  <TextBlock Text="Direct PC-to-PC receive will appear here when that route is qualified."
                             Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap"
                             Margin="0,7,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Not enabled in this build" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0"/>
              </Grid>
            </Button>
          </Grid>

          <Border Classes="soft" MaxWidth="720" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="RoboTransfer preserves the source, skips unsupported cloud-only data, and verifies transferred files before the job is considered complete."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
          </Border>
        </StackPanel>

        <!-- SETUP -->
        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="18">
          <StackPanel>
            <TextBlock Classes="h1" Text="Set up this transfer"/>
            <TextBlock Text="Analyze the PC, choose the employee profile, then choose an approved destination."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="15"
                       Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="h2" Text="1. Analyze this PC"/>
                <TextBlock Text="{Binding PolicySummary}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="{Binding AnalysisButtonText}"
                      Command="{Binding RefreshCommand}"
                      IsEnabled="{Binding !IsAnalyzing}"/>
            </Grid>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasError}" BorderBrush="{StaticResource WarningBrush}">
            <StackPanel>
              <TextBlock Text="Policy needs attention" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding EnvironmentRows}" IsVisible="{Binding HasAnalysis}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EnvironmentRow">
                <Border Classes="card" Padding="18" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="170,*,Auto">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="2"
                            Classes="badge"
                            Classes.available="{Binding IsAvailable}"
                            Classes.warning="{Binding IsWarning}"
                            Classes.blocked="{Binding IsBlocked}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card" IsVisible="{Binding HasAnalysis}">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="2. Choose the employee"/>
              <ComboBox ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        PlaceholderText="Select a registered Windows profile"
                        MinHeight="46">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:UserProfile">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding ProfileDetail}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding HasAnalysis}">
            <StackPanel Spacing="12">
              <StackPanel>
                <TextBlock Classes="h2" Text="3. Choose how to move it"/>
                <TextBlock Text="Only destinations allowed by the current policy appear here."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
              </StackPanel>

              <ListBox Classes="wizardOptions"
                       ItemsSource="{Binding Operations.Destinations}"
                       SelectedItem="{Binding Operations.SelectedDestination}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DestinationOption">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="→" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="{Binding Destination.Route}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Classes="soft" IsVisible="{Binding !CanContinueFromSetup}">
                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
              </Border>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Nothing is transferred during setup." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="Continue"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinueFromSetup}"/>
          </Grid>
        </StackPanel>

        <!-- DATA -->
        <StackPanel IsVisible="{Binding IsDataPage}" Spacing="18">
          <StackPanel>
            <TextBlock Classes="h1" Text="Choose what to move"/>
            <TextBlock Text="{Binding Operations.SourceSummary}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="h2" Text="Folders"/>
                  <TextBlock Text="Select the Windows Known Folders to include." Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="badge"><TextBlock Text="SOURCE PRESERVED" FontSize="10" FontWeight="SemiBold"/></Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding Operations.Folders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KnownFolderSelection">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                      <Grid ColumnDefinitions="Auto,180,*">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEligible}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Folder.Kind}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="h2" Text="Scan"/>
                  <TextBlock Text="RoboTransfer inventories only the selected folders before anything is copied."
                             Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Operations.Stage}" FontSize="10" FontWeight="SemiBold"/></Border>
              </Grid>

              <Grid ColumnDefinitions="*,*,*,*" Margin="0,6,0,0">
                <StackPanel><TextBlock Classes="caption" Text="FILES"/><TextBlock Text="{Binding Operations.Files}" FontSize="21" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="DATA"/><TextBlock Text="{Binding Operations.BytesText}" FontSize="21" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="SKIPPED"/><TextBlock Text="{Binding Operations.Skipped}" FontSize="21" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Classes="caption" Text="WARNINGS"/><TextBlock Text="{Binding Operations.Warnings}" FontSize="21" FontWeight="SemiBold"/></StackPanel>
              </Grid>

              <ProgressBar IsIndeterminate="{Binding Operations.IsBusy}" Height="8"/>
              <TextBlock Text="{Binding Operations.Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="Scan selected folders" Command="{Binding Operations.StartScanCommand}" IsEnabled="{Binding Operations.CanScan}"/>
                <Button Classes="secondary" Content="Cancel" Command="{Binding Operations.CancelCommand}" IsEnabled="{Binding Operations.IsBusy}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Cloud-only or unavailable data stays untouched and is reported as skipped."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="600"/>
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="Review transfer"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinueToReview}"/>
          </Grid>
        </StackPanel>

        <!-- REVIEW -->
        <StackPanel IsVisible="{Binding IsReviewPage}" Spacing="18">
          <StackPanel>
            <TextBlock Classes="h1" Text="Review before transfer"/>
            <TextBlock Text="One final check. Locking the plan freezes the source, destination and safety rules."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="15"
                       Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card">
            <Grid ColumnDefinitions="160,*,160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
              <TextBlock Classes="caption" Text="SOURCE"/>
              <TextBlock Grid.Column="1" Text="{Binding Operations.SourceSummary}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2" Classes="caption" Text="DESTINATION"/>
              <TextBlock Grid.Column="3" Text="{Binding Operations.DestinationSummary}" FontWeight="SemiBold"/>

              <TextBlock Grid.Row="1" Classes="caption" Text="FOLDERS"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operations.SelectedFoldersSummary}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="ROUTE"/>
              <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Operations.RouteSummary}"/>

              <TextBlock Grid.Row="2" Classes="caption" Text="FILES"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Operations.Files}"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Classes="caption" Text="DATA"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Operations.BytesText}"/>

              <TextBlock Grid.Row="3" Classes="caption" Text="CONFLICT SAFETY"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Operations.ConflictSummary}"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Classes="caption" Text="VERIFICATION"/>
              <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Operations.VerificationSummary}"/>

              <TextBlock Grid.Row="4" Classes="caption" Text="ROBOCOPY"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Operations.RobocopySummary}"/>
              <TextBlock Grid.Row="4" Grid.Column="2" Classes="caption" Text="CLOUD SKIPPED"/>
              <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding Operations.Skipped}"/>
            </Grid>
          </Border>

          <Border Classes="soft">
            <TextBlock Text="KeepBoth preserves existing destination files. RoboTransfer never deletes or replaces source data."
                       TextWrapping="Wrap"/>
          </Border>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <CheckBox Content="I reviewed the source, destination and transfer summary"
                        IsChecked="{Binding Operations.ReviewConfirmed}"
                        VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Classes="primary"
                      Content="Lock transfer plan"
                      Command="{Binding Operations.LockPlanCommand}"
                      IsEnabled="{Binding Operations.CanLockPlan}"/>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Operations.Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="Continue to transfer"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinueToTransfer}"/>
          </Grid>
        </StackPanel>

        <!-- TRANSFER -->
        <StackPanel IsVisible="{Binding IsTransferPage}" Spacing="20">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Classes="h1" Text="Ready to transfer" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Operations.DestinationSummary}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card" Padding="32">
            <StackPanel Spacing="20">
              <Border Width="82" Height="82" CornerRadius="41" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Text="→" FontSize="42" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>

              <ProgressBar IsIndeterminate="{Binding Operations.IsBusy}" Height="12"/>

              <Grid ColumnDefinitions="*,*,*,*" MaxWidth="700" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center"><TextBlock Classes="caption" Text="FILES"/><TextBlock Text="{Binding Operations.Files}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Classes="caption" Text="DATA"/><TextBlock Text="{Binding Operations.BytesText}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Classes="caption" Text="SKIPPED"/><TextBlock Text="{Binding Operations.Skipped}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center"><TextBlock Classes="caption" Text="FAILED"/><TextBlock Text="{Binding Operations.Failures}" FontSize="24" FontWeight="SemiBold"/></StackPanel>
              </Grid>

              <TextBlock Text="{Binding Operations.Status}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Classes="primary" Content="Start transfer" Command="{Binding Operations.StartTransferCommand}" IsEnabled="{Binding Operations.CanTransfer}"/>
                <Button Classes="secondary" Content="Cancel" Command="{Binding Operations.CancelCommand}" IsEnabled="{Binding Operations.IsBusy}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Classes="primary"
                  Content="Continue to verification"
                  Command="{Binding ContinueCommand}"
                  IsEnabled="{Binding CanContinueToVerification}"
                  HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- VERIFICATION -->
        <StackPanel IsVisible="{Binding IsVerificationPage}" Spacing="20">
          <StackPanel>
            <TextBlock Classes="h1" Text="Verify the transfer"/>
            <TextBlock Text="Transfer and verification are separate. RoboTransfer checks the copied data before completion."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="15"
                       Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card" Padding="30">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="Integrity check"/>
                <Border Grid.Column="1" Classes="badge available"><TextBlock Text="{Binding Operations.VerificationMode}" FontWeight="SemiBold"/></Border>
              </Grid>

              <ProgressBar IsIndeterminate="{Binding Operations.IsBusy}" Height="12"/>

              <Grid ColumnDefinitions="*,*,*,*">
                <StackPanel><TextBlock Classes="caption" Text="CHECKED DATA"/><TextBlock Text="{Binding Operations.BytesText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="MISMATCHES"/><TextBlock Text="{Binding Operations.Mismatches}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="FAILED"/><TextBlock Text="{Binding Operations.Failures}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Classes="caption" Text="SKIPPED"/><TextBlock Text="{Binding Operations.Skipped}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
              </Grid>

              <TextBlock Text="{Binding Operations.Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="Start verification" Command="{Binding Operations.StartVerificationCommand}" IsEnabled="{Binding Operations.CanVerify}"/>
                <Button Classes="secondary" Content="Retry failed items" Command="{Binding Operations.RetryVerificationCommand}" IsEnabled="{Binding Operations.CanRetryVerification}"/>
                <Button Classes="secondary" Content="Cancel" Command="{Binding Operations.CancelCommand}" IsEnabled="{Binding Operations.IsBusy}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Classes="primary"
                  Content="Continue to report"
                  Command="{Binding ContinueCommand}"
                  IsEnabled="{Binding CanContinueToReport}"
                  HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- REPORT -->
        <StackPanel IsVisible="{Binding IsReportPage}" Spacing="22">
          <StackPanel HorizontalAlignment="Center" MaxWidth="720">
            <Border Width="86" Height="86" CornerRadius="43" Background="#E6F4EF" HorizontalAlignment="Center">
              <TextBlock Text="✓" FontSize="42" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Classes="h1" Text="Migration evidence" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock Text="Generate the final technician report after verification."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="15"
                       TextAlignment="Center"
                       Margin="0,6,0,0"/>
          </StackPanel>

          <Border Classes="card" MaxWidth="760" HorizontalAlignment="Center">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="150,*">
                <TextBlock Classes="caption" Text="SOURCE"/>
                <TextBlock Grid.Column="1" Text="{Binding Operations.SourceSummary}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Classes="caption" Text="DESTINATION" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operations.DestinationSummary}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2" Classes="caption" Text="REPORT" Margin="0,12,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Operations.ReportLocation}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </Grid>

              <Button Classes="primary"
                      Content="Generate final report"
                      Command="{Binding Operations.GenerateReportCommand}"
                      IsEnabled="{Binding Operations.CanGenerateReport}"
                      HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding Operations.Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Button Classes="secondary" Content="Start another migration" Command="{Binding StartOverCommand}" HorizontalAlignment="Center"/>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
