<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoboTransfer.App.ViewModels"
        xmlns:core="using:RoboTransfer.Core"
        xmlns:views="using:RoboTransfer.App.Views"
        x:Class="RoboTransfer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RoboTransfer" Width="1080" Height="820" MinWidth="900" MinHeight="650">
  <Grid RowDefinitions="76,Auto,*,40">
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="28,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}">
            <TextBlock Text="⇄" Foreground="White" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="RoboTransfer" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="A fresh PC. Everything you need." Classes="caption"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Classes="badge"><TextBlock Text="QUALIFICATION BUILD" FontSize="10" FontWeight="SemiBold"/></Border>
      </Grid>
    </Border>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" IsVisible="{Binding ShowBack}" Margin="24,20,24,4" HorizontalAlignment="Center">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="26"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WorkflowStep">
          <StackPanel Width="92" Spacing="6">
            <Border Classes="step" Classes.current="{Binding IsCurrent}" Classes.complete="{Binding IsComplete}" HorizontalAlignment="Center">
              <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12"/>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="32,22,32,28" MaxWidth="920" HorizontalAlignment="Stretch">
        <!-- Choose this PC's role. Direct receiving remains visibly unavailable. -->
        <StackPanel IsVisible="{Binding IsWelcomePage}" Spacing="24">
          <views:PcTransferIllustration Width="430" Height="165" HorizontalAlignment="Center"/>
          <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="700">
            <TextBlock Classes="h1" Text="Your work, ready for its next home." TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Classes="subtitle" Text="Move your files to a new PC. We’ll guide you through it." TextAlignment="Center"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,20,*">
            <Button Classes="choice" Command="{Binding SelectSenderCommand}" AutomationProperties.AutomationId="ChooseOldPc">
              <StackPanel Spacing="12">
                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="↑" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="This is my old PC" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Classes="subtitle" Text="Choose the files you want to send to an approved drive or network share."/>
                <TextBlock Text="Send my files  →" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
              </StackPanel>
            </Button>
            <Border Grid.Column="2" Classes="card" Background="#F0F3F7" Padding="28">
              <StackPanel Spacing="12">
                <Border Width="52" Height="52" CornerRadius="26" Background="#E3E9F0" HorizontalAlignment="Left"><TextBlock Text="↓" FontSize="28" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="This is my new PC" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Classes="subtitle" Text="Direct PC-to-PC receiving is not available in this build."/>
                <TextBlock Text="Coming later" Classes="caption" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Classes="caption" Text="Your source files stay on the old PC. Copied files are verified separately." TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSetupPage}" Spacing="18">
          <StackPanel Spacing="7"><TextBlock Classes="h1" Text="Let’s get connected"/><TextBlock Classes="subtitle" Text="Check this PC, choose the employee, then choose where to send the files."/></StackPanel>
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="5"><TextBlock Classes="h2" Text="Check this PC"/><TextBlock Classes="caption" Text="{Binding PolicySummary}"/></StackPanel>
              <Button Grid.Column="1" Classes="primary" Content="{Binding AnalysisButtonText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsAnalyzing}"/>
            </Grid>
          </Border>
          <ProgressBar IsVisible="{Binding IsAnalyzing}" IsIndeterminate="True" Height="6"/>
          <Border Classes="soft" IsVisible="{Binding HasError}"><StackPanel Spacing="6"><TextBlock Text="Setup needs attention" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card" IsVisible="{Binding HasAnalysis}">
            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Whose files are we moving?"/>
              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" PlaceholderText="Choose an employee profile" HorizontalAlignment="Stretch" MinHeight="46">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="core:UserProfile"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Text="{Binding ProfileDetail}"/>
              <TextBlock Classes="h2" Text="How do you want to move them?" Margin="0,8,0,0"/>
              <ListBox Classes="wizardOptions" ItemsSource="{Binding Operations.Destinations}" SelectedItem="{Binding Operations.SelectedDestination}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DestinationOption">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                      <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="→" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding RouteLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding Display}" Classes="caption" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock IsVisible="{Binding !CanContinueFromSetup}" Text="{Binding Recommendation}" Classes="subtitle"/>
            </StackPanel>
          </Border>
          <Expander Header="Technical checks" IsVisible="{Binding HasAnalysis}" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding EnvironmentRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnvironmentRow">
                  <Border Classes="card" Padding="16" Margin="0,8,0,0">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><Border Grid.Column="1" Classes="badge" Classes.available="{Binding IsAvailable}" Classes.warning="{Binding IsWarning}" Classes.blocked="{Binding IsBlocked}"><TextBlock Text="{Binding Value}" FontSize="11" MaxWidth="520" TextTrimming="CharacterEllipsis"/></Border></Grid>
                      <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Header="Resume an unfinished migration" IsVisible="{Binding Operations.HasRecovery}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10" Margin="0,12,0,0">
              <ComboBox ItemsSource="{Binding Operations.RecoverableSessions}" SelectedItem="{Binding Operations.SelectedRecovery}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="core:MigrationSession"><TextBlock Text="{Binding Id}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Analyze this PC and select the matching profile and destination first." Classes="subtitle"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="secondary" Content="Validate and resume" Command="{Binding Operations.ResumeCommand}"/><Button Classes="secondary" Content="Abandon session" Command="{Binding Operations.AbandonCommand}"/></StackPanel>
              <TextBlock Text="{Binding Operations.Status}" Classes="subtitle"/>
            </StackPanel>
          </Expander>
          <Button Classes="primary" Content="Next: choose files  →" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinueFromSetup}" HorizontalAlignment="Right"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDataPage}" Spacing="18">
          <StackPanel Spacing="7"><TextBlock Classes="h1" Text="What would you like to bring?"/><TextBlock Classes="subtitle" Text="{Binding Operations.SourceSummary}"/></StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding Operations.SelectionSummary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Operations.CanEditSelection}"><Button Classes="secondary" Content="Select all" Command="{Binding Operations.SelectAllCommand}" Padding="12,6" MinHeight="34"/><Button Classes="secondary" Content="Clear" Command="{Binding Operations.SelectNoneCommand}" Padding="12,6" MinHeight="34"/></StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding Operations.Folders}" IsEnabled="{Binding Operations.CanEditSelection}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KnownFolderSelection">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEligible}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                          <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding Icon}" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Classes="caption"/></StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="caption" VerticalAlignment="Center"/>
                        </Grid>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="soft"><StackPanel Spacing="8"><ProgressBar IsVisible="{Binding Operations.IsBusy}" IsIndeterminate="True" Height="6"/><TextBlock Text="{Binding Operations.Status}" TextWrapping="Wrap"/><TextBlock Classes="caption" Text="Cloud-only files, unavailable items and OST caches are excluded and reported."/></StackPanel></Border>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Nothing is copied during the scan." Classes="caption" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Classes="secondary" Content="Cancel scan" Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.IsBusy}"/><Button Classes="primary" Content="Scan and review  →" Command="{Binding Operations.StartScanCommand}" IsEnabled="{Binding Operations.CanScan}"/></StackPanel></Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReviewPage}" Spacing="18">
          <StackPanel Spacing="7"><TextBlock Classes="h1" Text="Ready for the move?"/><TextBlock Classes="subtitle" Text="Check the details below. Nothing has been copied yet."/></StackPanel>
          <views:PcTransferIllustration Width="330" Height="125" HorizontalAlignment="Center"/>
          <Border Classes="card">
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
              <TextBlock Classes="caption" Text="FROM"/><TextBlock Grid.Column="1" Text="{Binding Operations.SourceSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Classes="caption" Text="TO"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operations.DestinationSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Classes="caption" Text="BRINGING"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Operations.SelectedFoldersSummary}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="3" Classes="caption" Text="INVENTORY"/><StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Operations.Files, StringFormat='{}{0:N0} files'}"/><TextBlock Text="{Binding Operations.BytesText}"/><TextBlock Text="{Binding Operations.Skipped, StringFormat='{}{0:N0} excluded'}"/></StackPanel>
              <TextBlock Grid.Row="4" Classes="caption" Text="EXISTING FILES"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Keep both copies · source preserved"/>
              <TextBlock Grid.Row="5" Classes="caption" Text="INTEGRITY CHECK"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Operations.VerificationSummary}"/>
            </Grid>
          </Border>
          <CheckBox Content="I checked the employee, destination and selected folders." IsChecked="{Binding Operations.ReviewConfirmed}"/>
          <TextBlock Text="{Binding Operations.Status}" Classes="subtitle"/>
          <Button Classes="primary" Content="Confirm transfer plan  →" Command="{Binding Operations.LockPlanCommand}" IsEnabled="{Binding Operations.CanLockPlan}" HorizontalAlignment="Right"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsTransferPage}" Spacing="22">
          <StackPanel Spacing="8" HorizontalAlignment="Center"><TextBlock Classes="h1" Text="{Binding Operations.TransferTitle}" TextAlignment="Center"/><TextBlock Classes="subtitle" Text="Keep this PC awake and the destination connected." TextAlignment="Center"/></StackPanel>
          <views:PcTransferIllustration Width="430" Height="165" HorizontalAlignment="Center"/>
          <Border Classes="card" Padding="30">
            <StackPanel Spacing="18">
              <TextBlock Text="{Binding Operations.ProgressText}" FontSize="54" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
              <ProgressBar Value="{Binding Operations.ProgressPercent}" IsIndeterminate="{Binding Operations.IsProgressIndeterminate}" Height="10" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding Operations.ProgressDetail}" Classes="subtitle" TextAlignment="Center"/>
              <Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Classes="caption" Text="CURRENT FOLDER"/><TextBlock Text="{Binding Operations.CurrentFolder}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="ELAPSED"/><TextBlock Text="{Binding Operations.ElapsedText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="FAILED"/><TextBlock Text="{Binding Operations.Failures}"/></StackPanel></Grid>
              <TextBlock Text="{Binding Operations.Status}" Classes="subtitle" TextAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"><Button Classes="primary" Content="Start transfer" Command="{Binding Operations.StartTransferCommand}" IsEnabled="{Binding Operations.CanTransfer}"/><Button Classes="secondary" Content="Cancel transfer" Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.IsBusy}"/></StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsVerificationPage}" Spacing="22">
          <StackPanel Spacing="7"><TextBlock Classes="h1" Text="Let’s check every copied file"/><TextBlock Classes="subtitle" Text="Copying is complete. Verify the files before considering the migration finished."/></StackPanel>
          <Border Classes="card" Padding="30">
            <StackPanel Spacing="20">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="h2" Text="File integrity"/><Border Grid.Column="1" Classes="badge"><TextBlock Text="{Binding Operations.VerificationMode}"/></Border></Grid>
              <ProgressBar Value="{Binding Operations.ProgressPercent}" IsIndeterminate="{Binding Operations.IsProgressIndeterminate}" Height="10" Foreground="{StaticResource AccentBrush}"/>
              <TextBlock Text="{Binding Operations.ProgressDetail}" Classes="subtitle"/>
              <Grid ColumnDefinitions="*,*,*"><StackPanel><TextBlock Classes="caption" Text="CHECKED DATA"/><TextBlock Text="{Binding Operations.BytesText}" FontSize="24"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="MISMATCHES"/><TextBlock Text="{Binding Operations.Mismatches}" FontSize="24"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Classes="caption" Text="FAILED"/><TextBlock Text="{Binding Operations.Failures}" FontSize="24"/></StackPanel></Grid>
              <TextBlock Text="{Binding Operations.Status}" Classes="subtitle"/>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="primary" Content="Verify my files" Command="{Binding Operations.StartVerificationCommand}" IsEnabled="{Binding Operations.CanVerify}"/><Button Classes="secondary" Content="Retry failed items" Command="{Binding Operations.RetryVerificationCommand}" IsEnabled="{Binding Operations.CanRetryVerification}"/><Button Classes="secondary" Content="Cancel" Command="{Binding Operations.CancelCommand}" IsVisible="{Binding Operations.IsBusy}"/></StackPanel>
            </StackPanel>
          </Border>
          <Button Classes="secondary" Content="Review verification report  →" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinueToReport}" HorizontalAlignment="Right"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReportPage}" Spacing="22">
          <Border Classes="result" Classes.verified="{Binding Operations.HasCleanVerification}" Width="88" Height="88" CornerRadius="44" HorizontalAlignment="Center"><TextBlock Text="{Binding Operations.ResultSymbol}" FontSize="44" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Spacing="8"><TextBlock Classes="h1" Text="{Binding Operations.ResultTitle}" TextAlignment="Center"/><TextBlock Classes="subtitle" Text="{Binding Operations.ResultDetail}" TextAlignment="Center"/></StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="18">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <TextBlock Classes="caption" Text="FROM"/><TextBlock Grid.Column="1" Text="{Binding Operations.SourceSummary}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Classes="caption" Text="TO"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Operations.DestinationSummary}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="2" Classes="caption" Text="REPORT"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Operations.ReportLocation}" TextWrapping="Wrap"/>
              </Grid>
              <TextBlock Text="{Binding Operations.Status}" Classes="subtitle"/>
              <Button Classes="primary" Content="Save migration report" Command="{Binding Operations.GenerateReportCommand}" IsEnabled="{Binding Operations.CanGenerateReport}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Button Classes="secondary" Content="Start another migration" Command="{Binding StartOverCommand}" IsEnabled="{Binding CanStartOver}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="24,0">
      <Button Classes="secondary" Content="← Back" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}" IsEnabled="{Binding CanGoBack}" MinHeight="30" Padding="12,3"/>
      <TextBlock Grid.Column="1" Text="Source preserved · Verification required" Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{Binding ApplicationVersion}" Classes="caption" FontSize="9" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
