<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoboTransfer.App.Views.MainWindow" Title="RoboTransfer — Enterprise PC Migration" Width="1180" Height="760" MinWidth="1040" MinHeight="680">
  <Grid RowDefinitions="68,*">
    <Border Background="{StaticResource NavyBrush}" Padding="28,0"><Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
      <StackPanel><TextBlock Text="RoboTransfer" Foreground="White" FontWeight="SemiBold" FontSize="22"/><TextBlock Text="Enterprise PC Migration" Foreground="#BFD0DC" FontSize="12"/></StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Workflow}" HorizontalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#243D51" CornerRadius="14" Padding="10,6"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Number}" Foreground="#9FC4D7"/><TextBlock Text="{Binding Name}" Foreground="White"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Grid.Column="2" Background="#243D51" CornerRadius="12" Padding="12,6"><TextBlock Text="PHASE 1 · ANALYSIS" Foreground="#D9E8F0" FontSize="11" FontWeight="SemiBold"/></Border>
    </Grid></Border>

    <ScrollViewer Grid.Row="1"><Grid Margin="28,22,28,30" RowDefinitions="Auto,16,Auto,16,*" MaxWidth="1280" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Classes="h1" Text="Environment readiness"/><TextBlock Classes="caption" Text="Read-only analysis of this endpoint and enterprise-approved migration options" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Button Classes="primary" Content="{Binding AnalysisButtonText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsAnalyzing}"/><TextBlock Classes="caption" Text="{Binding PolicySummary}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid>

      <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasError}" BorderBrush="{StaticResource WarningBrush}" Background="#FFFAEB"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="!" FontSize="20" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="Policy attention required" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Grid></Border>

      <Grid Grid.Row="4" ColumnDefinitions="1.15*,16,0.85*" RowDefinitions="Auto,16,Auto">
        <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Classes="h2" Text="Endpoint environment"/><Border Grid.Column="1" Classes="badge"><TextBlock Text="READ-ONLY" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
          <ItemsControl ItemsSource="{Binding EnvironmentRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid ColumnDefinitions="210,*,Auto"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Value}"/><TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxWidth="360"/></StackPanel><Border Grid.Column="2" Classes="badge" Classes.available="{Binding IsAvailable}" Classes.warning="{Binding IsWarning}" Classes.blocked="{Binding IsBlocked}" Margin="12,0,0,0"><TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" MaxWidth="130" TextTrimming="CharacterEllipsis"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Background="#F7F9FB" CornerRadius="5" Padding="16" IsVisible="{Binding !HasAnalysis}"><TextBlock Text="No endpoint analysis has been run. Select Refresh analysis to inspect available capabilities without changing this PC." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></Border>
        </StackPanel></Border>

        <Border Grid.Column="2" Classes="card"><StackPanel Spacing="14"><TextBlock Classes="h2" Text="Source device"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Classes="caption" Text="DEVICE ROLE"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" MinHeight="38"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Classes="caption" Text="REGISTERED PROFILE"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinHeight="38" PlaceholderText="Select employee profile"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Grid>
          <Border Background="#F7F9FB" CornerRadius="6" Padding="16"><StackPanel Spacing="5"><TextBlock Text="Profile resolution" FontWeight="SemiBold"/><TextBlock Text="{Binding ProfileDetail}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Selection does not scan or transfer files." Classes="caption"/></StackPanel></Border>
          <StackPanel Spacing="7"><TextBlock Classes="caption" Text="KNOWN FOLDERS"/><ItemsControl ItemsSource="{Binding SelectedProfile.KnownFolders}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="140,*,Auto" Margin="0,4"><TextBlock Text="{Binding Kind}"/><TextBlock Grid.Column="1" Text="{Binding Resolution}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="2" Text="{Binding Exists, StringFormat={}{0}}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        </StackPanel></Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Background="#F7FBFC" BorderBrush="#AACCD8"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Classes="caption" Text="RECOMMENDED METHOD"/><TextBlock Text="{Binding Recommendation}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{Binding RecommendationDetail}" TextWrapping="Wrap" MaxWidth="820" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Classes="primary" Content="Prepare migration" IsEnabled="False" ToolTip.Tip="Transfer preparation becomes available in Phase 2 after manifest review and explicit confirmation."/><TextBlock Classes="caption" Text="Not available in Phase 1" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Grid></Border>
      </Grid>
    </Grid></ScrollViewer>
  </Grid>
</Window>
