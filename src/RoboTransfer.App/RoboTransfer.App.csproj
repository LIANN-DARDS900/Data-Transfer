<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RoboTransfer</AssemblyName>
    <RootNamespace>RoboTransfer.App</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RoboTransfer.Core/RoboTransfer.Core.csproj" />
    <ProjectReference Include="../RoboTransfer.Windows/RoboTransfer.Windows.csproj" />
    <ProjectReference Include="../RoboTransfer.Robocopy/RoboTransfer.Robocopy.csproj" />
    <ProjectReference Include="../RoboTransfer.Usmt/RoboTransfer.Usmt.csproj" />
    <ProjectReference Include="../RoboTransfer.Persistence/RoboTransfer.Persistence.csproj" />
    <ProjectReference Include="../RoboTransfer.Verification/RoboTransfer.Verification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
