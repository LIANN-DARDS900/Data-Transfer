<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RoboTransfer.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <Color x:Key="CanvasColor">#F4F7FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="NavyColor">#102A43</Color>
    <Color x:Key="TextColor">#142B3A</Color>
    <Color x:Key="MutedColor">#60758A</Color>
    <Color x:Key="BorderColor">#D9E3EC</Color>
    <Color x:Key="AccentColor">#0B74B8</Color>
    <Color x:Key="AccentSoftColor">#EAF5FC</Color>
    <Color x:Key="SuccessColor">#147D64</Color>
    <Color x:Key="WarningColor">#9A6700</Color>
    <Color x:Key="DangerColor">#B42318</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="24"/>
    </Style>

    <Style Selector="Border.soft">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Background" Value="#E9EEF2"/>
    </Style>

    <Style Selector="Border.badge.available">
      <Setter Property="Background" Value="#E6F4EF"/>
    </Style>
    <Style Selector="Border.badge.available TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
    </Style>

    <Style Selector="Border.badge.warning">
      <Setter Property="Background" Value="#FFF4D6"/>
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
      <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
    </Style>

    <Style Selector="Border.badge.blocked">
      <Setter Property="Background" Value="#FEECEB"/>
    </Style>
    <Style Selector="Border.badge.blocked TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,11"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.choice">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="28"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="190"/>
    </Style>

    <Style Selector="Button.choice:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="#F8FCFF"/>
    </Style>

    <Style Selector="ListBox.wizardOptions">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBox.wizardOptions ListBoxItem">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ListBox.wizardOptions ListBoxItem:selected">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Application.Styles>
</Application>
